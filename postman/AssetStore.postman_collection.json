{
  "info": {
    "name": "Asset Store API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All public endpoints of Asset Store (README, API).\n\n- Locally: `npm run dev`, baseUrl = http://localhost:5173 (Vite sends /api to the services like Caddy on the server).\n- Server: baseUrl = https://3-125-15-78.sslip.io.\n\nLogin sets the access_token and refresh_token cookies; Postman keeps them and sends them with the next requests. Run \"Auth / Login\" first, then the rest: upload, edit and delete need the login (401 without it). \"Assets / Create\" needs a file: in Body pick a file for the field \"file\"."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5173"
    },
    {
      "key": "email",
      "value": "admin@example.com",
      "description": "Local admin from the seed (cd services/identity && npx tsx src/seed.ts)"
    },
    {
      "key": "password",
      "value": "",
      "description": "SEED_ADMIN_PASSWORD from services/identity/.env"
    },
    {
      "key": "assetId",
      "value": "",
      "description": "Filled by Assets / List and Assets / Create"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Identity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/identity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "identity"
              ]
            },
            "description": "State of the identity service and its database."
          }
        },
        {
          "name": "Catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/catalog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "catalog"
              ]
            },
            "description": "State of the catalog service and its database."
          }
        },
        {
          "name": "Community",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/community",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "community"
              ]
            },
            "description": "State of the community service and its database."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "New account with the role USER. Username 1–50 chars, valid e-mail, password at least 8 chars. 409 when the username or e-mail is taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user{{$timestamp}}\",\n  \"email\": \"user{{$timestamp}}@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Sets the access_token (15 min) and refresh_token (30 days) cookies. 401 wrong e-mail or password, 403 suspended account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "The signed-in user. 401 without a valid access token: call Refresh or Login."
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "New access token and new refresh token; the old refresh token stops working."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Ends the session and clears both cookies."
          }
        }
      ]
    },
    {
      "name": "Assets",
      "item": [
        {
          "name": "List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().itemList;",
                  "if (items.length) pm.collectionVariables.set('assetId', items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets?name=&pageIndex=0&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "",
                  "description": "Part of the name, any letter case, at most 100 characters"
                },
                {
                  "key": "pageIndex",
                  "value": "0",
                  "description": "Page number from 0"
                },
                {
                  "key": "pageSize",
                  "value": "20",
                  "description": "1 to 100"
                }
              ]
            },
            "description": "A page of the catalogue (20 per page), newest first."
          }
        },
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('assetId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ]
            },
            "description": "Uploads a new asset (multipart/form-data). Pick a file for the field \"file\". Types: 2d, 3d, map, sound, environment.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Sword",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Low poly sword",
                  "type": "text"
                },
                {
                  "key": "type",
                  "value": "3d",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Get",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}"
              ]
            },
            "description": "One asset. 404 when it does not exist."
          }
        },
        {
          "name": "Update",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}"
              ]
            },
            "description": "Changes the name and description; the file stays.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sword (edited)\",\n  \"description\": \"New description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Download",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}",
                "download"
              ]
            },
            "description": "Downloads the file and raises the download count. In Postman: Send and Download."
          }
        },
        {
          "name": "Delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}"
              ]
            },
            "description": "Deletes the asset and its file."
          }
        }
      ]
    }
  ]
}
