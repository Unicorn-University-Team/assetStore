                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/catalog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "catalog"
              ]
            },
            "description": "State of the catalog service and its database."
          }
        },
        {
          "name": "Community",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/community",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "community"
              ]
            },
            "description": "State of the community service and its database."
