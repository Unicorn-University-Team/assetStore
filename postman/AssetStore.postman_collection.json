          "name": "Identity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/identity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "identity"
              ]
            },
            "description": "State of the identity service and its database."
          }
        },
        {
