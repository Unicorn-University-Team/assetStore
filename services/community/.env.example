NODE_ENV=development
PORT=3003

# Local PostgreSQL from the root docker-compose.yml (`docker compose up -d db-init`), database "community";
# the password is POSTGRES_PASSWORD from the root .env.
DATABASE_URL=postgres://assetstore:PASSWORD@localhost:5432/community

# Address of the catalog service (`npm run dev` in services/catalog).
CATALOG_URL=http://localhost:3002
# Shared secret for calls between services (X-Internal-Key). Same value in every service; empty is fine locally.
INTERNAL_KEY=
