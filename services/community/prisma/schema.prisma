// Database schema of the community service (its own database: community).
// After a change: `npm run db:migrate -- --name <what-changed>` creates a migration in prisma/migrations
// and regenerates the client in src/generated/prisma.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// A user's report of an asset (REP-1…3): US-5 report, US-6 accept, US-7 deny. Asset and users live in other
// services, so only their ids are stored here; names come from catalog and identity when reports are read.
model Report {
  id           String    @id @default(uuid()) @db.Uuid
  assetId      String    @map("asset_id") @db.Uuid
  // Copy of the asset name when it was reported, kept for the history after the asset is deleted (AM reportSchema).
  assetName    String    @map("asset_name") @db.VarChar(100)
  // Owner of the asset when it was reported (from catalog); stays known even after the asset is deleted.
  assetOwnerId String?   @map("asset_owner_id") @db.Uuid
  // Who reported it.
  authorId     String    @map("author_id") @db.Uuid
  // inappropriateContent | copyright | spam | brokenFile | other (AM; REPORT_REASONS in ReportModel, CHECK in the migration)
  reason       String    @db.VarChar(20)
  comment      String    @default("") @db.VarChar(500)
  // open | resolved | rejected (CHECK in the migration)
  status       String    @default("open") @db.VarChar(10)
  // The admin who accepted or denied the report, and when.
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // One open report per author and asset: partial unique index "report_one_open_per_author_asset" (only in the
  // report_per_am migration, Prisma cannot express it).
  @@index([status, createdAt])
  // Admin list filtered by asset owner (report/list assetOwnerId), newest first.
  @@index([assetOwnerId, createdAt])
  @@index([assetId])
  @@map("report")
}

// A user's review of an asset: a rating 1–5 (CHECK in the add_review migration) and an optional comment. One review
// per user and asset. The asset and the user live in other services, so only their ids are stored here.
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  rating    Int
  comment   String?  @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([authorId, assetId])
  @@index([assetId])
  @@index([createdAt])
  @@map("review")
}

// A user's collection of assets (COL-1…2). The owner comes from the access token, never from the request, and only the
// owner sees the collection. The owner lives in identity, so only the id is stored here.
model Collection {
  id          String            @id @default(uuid()) @db.Uuid
  ownerId     String            @map("owner_id") @db.Uuid
  name        String            @db.VarChar(100)
  description String            @default("") @db.VarChar(2000)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  assets      CollectionAsset[]

  @@index([ownerId])
  @@map("collection")
}

// Which assets a collection holds; an asset is in a collection at most once. Deleting a collection removes its links.
// The asset lives in catalog, so there is no foreign key: when an asset is deleted, its links are removed by id.
model CollectionAsset {
  collectionId String     @map("collection_id") @db.Uuid
  assetId      String     @map("asset_id") @db.Uuid
  addedAt      DateTime   @default(now()) @map("added_at")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, assetId])
  @@index([assetId])
  @@map("collection_asset")
}

// Audit log (README, Audit log): who did what to which object and when. Each service keeps its own table with the
// same columns. Rows are only ever added: never updated or deleted.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  // Empty until the service knows the logged-in user (the token check is not in packages/shared yet).
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(30)
  objectType String   @map("object_type") @db.VarChar(20)
  objectId   String   @map("object_id") @db.Uuid
  // Only for assetUpdated (catalog); null here.
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([objectType, objectId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}
