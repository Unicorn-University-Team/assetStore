NODE_ENV=development
PORT=3001

# Local PostgreSQL from the root docker-compose.yml (`docker compose up -d db-init`), database "identity";
# the password is POSTGRES_PASSWORD from the root .env.
DATABASE_URL=postgres://assetstore:PASSWORD@localhost:5432/identity

# RS256 key pair for access tokens, PEM in base64 on one line (README, Přihlášení).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Passwords for src/seed.ts: the admin always, the demo users only with NODE_ENV=development.
SEED_ADMIN_PASSWORD=
SEED_DEMO_USER_PASSWORD=
SEED_DEMO_USER_SUS_PASSWORD=
