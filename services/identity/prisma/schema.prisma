// Database schema of the identity service (its own database: identity). No models yet.
// After a change: `npm run db:migrate -- --name <what-changed>` creates a migration in prisma/migrations
// and regenerates the client in src/generated/prisma.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  SUSPENDED
}

model User {
  id Int @id @default(autoincrement())
  username String @db.VarChar(50) @unique
  email String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(255)
  role Role @default(USER)
  status Status @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}