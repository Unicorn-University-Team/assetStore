// Database schema. After a change: `npm run db:migrate -- --name <what-changed>` creates a migration
// in prisma/migrations and regenerates the client in src/generated/prisma.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  description   String   @default("")
  // 2d | 3d | map | sound | environment, checked in the controller
  type          String   @db.VarChar(20)
  // Generated S3 object key; the file is only served through GET /api/assets/:id/download
  fileKey       String   @unique @map("file_key")
  fileName      String   @map("file_name")
  fileSize      Int      @map("file_size")
  contentType   String   @map("content_type")
  downloadCount Int      @default(0) @map("download_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("asset")
}

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  // 1 to 50 characters: lower case letters, digits and a hyphen (CHECK "tag_name_check" in the add_tag migration)
  name String @unique @db.VarChar(50)

  @@map("tag")
}

// Audit log (README, Audit log): who did what to which object and when. Each service keeps its own table with the
// same columns. Rows are only ever added: never updated or deleted.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  // Empty until catalog knows the logged-in user (the token check is not in packages/shared yet).
  actorId    String?  @map("actor_id") @db.Uuid
  // assetCreated | assetUpdated | assetDeleted, checked in AuditLogModel
  action     String   @db.VarChar(30)
  objectType String   @map("object_type") @db.VarChar(20)
  objectId   String   @map("object_id") @db.Uuid
  // Only for assetUpdated: { field: { old, new } } for each changed field
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([objectType, objectId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}
