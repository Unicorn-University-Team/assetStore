# Copy to .env (next to docker-compose.yml) and fill in.

# Letters and digits only, it is put into DATABASE_URL. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Empty = plain HTTP on port 80. A domain pointing to the server = automatic HTTPS.
SITE_ADDRESS=

# on = one shared login for the whole site (use only together with HTTPS), off = open site.
# Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the hash in single quotes, it contains $ characters.
SITE_AUTH=off
SITE_AUTH_USER=
SITE_AUTH_HASH=

# S3 bucket with asset files. The server reaches it through the IAM role of the EC2 instance.
S3_BUCKET=
AWS_REGION=eu-central-1
# Upload size limit in megabytes.
MAX_UPLOAD_MB=100
# Limit for all asset files together, in gigabytes; uploads are refused once it is reached.
MAX_STORAGE_GB=5

# Shared team key for upload, edit and delete (X-Write-Key header) until there are user accounts.
# Empty = anyone can write. Generate: openssl rand -hex 16
WRITE_KEY=
