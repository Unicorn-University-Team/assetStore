NODE_ENV=development
PORT=3000

# Local PostgreSQL from the root docker-compose.yml (`docker compose up -d db`);
# the password is POSTGRES_PASSWORD from the root .env.
DATABASE_URL=postgres://assetstore:PASSWORD@localhost:5432/assetstore

# S3 bucket with asset files.
S3_BUCKET=
AWS_REGION=eu-central-1
# Access key of the IAM user for local development. Never commit them;
# the server does not need keys, it uses the IAM role of the EC2 instance.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upload size limit in megabytes.
MAX_UPLOAD_MB=100
